# 编译后的文件
target/
*.class
javac.*.args

# IDEA 配置文件
.idea/
*.iml

# 如果你根目录下有日志，可以忽略日志
# Logs / local diagnostics
logs/
*.log
*.tmp
tmp_*.ps1
thread-dump-*.txt

# Python cache
__pycache__/
*.pyc

# JavaFX UI 本机偏好设置，不上传到 Git
config/ui-game-settings.properties

# 本机专属配置（换机时改这里，不改 Git 跟踪的文件）。模板 .example 要保留在 Git 里。
config/application.properties

# 运行时配置备份，不上传 Git
config/backup/
config/*.backup-*

# 本地一次性调试入口，不上传到 Git
src/main/java/com/bot/dhxy/debug/LocationSyncBenchmarkMain.java

# 操作系统临时文件
.DS_Store
Thumbs.db

# Local design / run reports
docs/design-audit/
docs/run-reports/


# Images: only images/template is tracked.
images/*
!images/template/
!images/template/**
!images/calibrate/
!images/calibrate/npc_menu_clean_sample.png

